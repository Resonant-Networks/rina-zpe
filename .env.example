# ==============================================================================
# RINA-ZPE Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ==============================================================================

# Nodegrid Device Credentials
NODEGRID_BASE_URL=https://127.0.0.1
NODEGRID_USERNAME=admin
NODEGRID_PASSWORD=your_nodegrid_password_here
NODEGRID_VERIFY_TLS=0

# Tailscale Gateway Settings
TAILSCALE_STATE_DIR=/home/admin/tailscale-state
TS_ADVERTISE_ROUTES=192.168.74.0/24

# Hermes Agent Integrations
HERMES_DATA_DIR=/home/agent/.hermes
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
OPENROUTER_API_KEY=sk-or-v1-your-key-here
